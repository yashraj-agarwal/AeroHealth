# AeroHealth — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control (it is already in .gitignore).
#
# Getting an Azure AI Language resource (free tier):
#   1. Go to https://portal.azure.com
#   2. Create a new resource → search "Language service"
#   3. Select "Language service" → Create
#   4. Choose Free tier (F0) — 5,000 text records/month at no cost
#   5. After deployment, go to Keys and Endpoint in the left pane
#   6. Copy Key 1 → paste as AZURE_LANGUAGE_KEY below
#   7. Copy Endpoint URL → paste as AZURE_LANGUAGE_ENDPOINT below
#
# If these variables are absent, the backend automatically falls back to the
# rule-based keyword classifier. The app is fully functional either way.
# ─────────────────────────────────────────────────────────────────────────────

# Azure AI Language (Text Analytics for Health)
AZURE_LANGUAGE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=<your-32-char-key-here>

# Backend server port (optional, defaults to 3001)
PORT=3001
